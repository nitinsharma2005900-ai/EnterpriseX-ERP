# Local PostgreSQL; copy this file to .env and supply your own secrets.
DATABASE_URL=postgresql://enterprisex:change-me@localhost:5432/enterprisex
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
SERVICE_TOKEN=replace-with-a-service-authentication-token
PORT=5000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000
PYTHON_SERVICE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379
# Real email webhook supporting Idempotency-Key; unset delivery produces an explicit failed job.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
# Docker Compose database configuration
POSTGRES_USER=enterprisex
POSTGRES_DB=enterprisex
POSTGRES_PASSWORD=replace-with-a-strong-database-password
