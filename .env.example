# ==============================================================================
# EnterpriseX Environment Configuration
# Safe template for development, staging and production
# ==============================================================================

# General
NODE_ENV=development
PORT=5000
FRONTEND_PORT=3000
PYTHON_SERVICE_PORT=8000

# Backend URL & Frontend URL
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
PYTHON_SERVICE_URL=http://localhost:8000

# Database (PostgreSQL for Docker/Production, SQLite/PostgreSQL for Local Dev)
DATABASE_URL=file:./dev.db
# For PostgreSQL Container / Production:
# DATABASE_URL=postgresql://enterprisex_admin:SecurePass123!@localhost:5432/enterprisex_db?schema=public

# Security & Authentication
JWT_SECRET=enterprisex_super_secret_jwt_key_development_only_change_in_production_32chars_minimum!
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=enterprisex_refresh_secret_development_only_change_in_production_32chars!
JWT_REFRESH_EXPIRES_IN=7d

# Redis & Caching / Background Jobs
REDIS_URL=redis://localhost:6379

# Integrations (Simulated / Sandboxed)
EMAIL_SERVICE_MODE=sandbox
DOCUMENT_STORAGE_MODE=local
VENDOR_API_MOCK_ENABLED=true
ACCOUNTING_EXPORT_PATH=./exports

# Observability
LOG_LEVEL=info
ENABLE_AUDIT_LOGGING=true
